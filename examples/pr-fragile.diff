+// Checkout module - synthetic fixture (seed 20261111).
+export interface Order {
+  id: string;
+  total: number;
+  currency: string;
+  items: number;
+  coupon: string | null;
+  customerTier: string;
+}
+
+function normalizeRule(rule: string): string {
+  return rule.trim().toLowerCase();
+}
+
+function validateRule(rule: string): boolean {
+  const clean = normalizeRule(rule);
+  return clean.length > 0 && clean.indexOf("free") === -1;
+}
+
+function parseRuleSet(raw: string): string[] {
+  const parts = raw.split(";");
+  const out: string[] = [];
+  for (const p of parts) {
+    if (validateRule(p)) out.push(normalizeRule(p));
+  }
+  return out;
+}
+
+function loadTierRules(tier: string): string[] {
+  const raw = tier + ";standard;express";
+  return parseRuleSet(raw);
+}
+
+function resolveTier(order: Order): string {
+  const rules = loadTierRules(order.customerTier);
+  if (rules.length === 0) return "standard";
+  return rules[0];
+}
+
+export function applyDiscount(order: Order): number {
+  const tier = resolveTier(order);
+  if (tier === "gold") return order.total * 0.9;
+  if (tier === "silver") return order.total * 0.95;
+  return order.total;
+}
+
+export function checkout(
+  order: Order,
+  currency: string,
+  taxRate: number,
+  shipping: number,
+  coupon: string | null,
+  giftWrap: boolean,
+): number {
+  let amount = applyDiscount(order);
+  if (currency !== order.currency) amount = amount * 1.1;
+  if (taxRate > 0) amount = amount * (1 + taxRate);
+  if (shipping > 0) amount = amount + shipping;
+  if (coupon) amount = amount - 5;
+  if (giftWrap) amount = amount + 2;
+  if (amount < 0) amount = 0;
+  if (order.items === 0) amount = 0;
+  if (order.items > 100) amount = amount * 0.99;
+  if (order.total > 1000) amount = amount * 0.98;
+  if (order.total < 10) amount = amount + 1;
+  if (currency === "EUR") amount = amount * 1.05;
+  return amount;
+}
+
+export function processOrder(order: Order): string {
+  const amount = checkout(order, order.currency, 0.2, 0, null, false);
+  const tier = resolveTier(order);
+  if (amount <= 0) return "empty";
+  if (tier === "gold") return "priority:" + String(amount);
+  return "standard:" + String(amount);
+}
